---
/**
 * ProblemBeforeAfter: two framed photographs, labelled, sitting beside each other.
 *
 * There is a fashionable version of this with a drag handle that wipes one image over the other.
 * It is not built here on purpose. It needs a pointer to operate, it is close to impossible to
 * work from a keyboard without inventing a control that behaves like nothing else on the page,
 * and on a phone the drag fights the page scroll. Two pictures side by side say the same thing
 * and every visitor can read them.
 *
 * On a phone the pair stacks, which is where the labels earn their place: the reader can no
 * longer tell "before" from "after" by position, so each figure states which it is.
 *
 * Both images are optional. A missing file leaves the ratio box standing, so a half-supplied pair
 * still lays out correctly and the gap is obviously a gap rather than a collapsed section. That
 * is also why a linked figure carries an explicit accessible name: the photograph is decorative
 * (the caption already says what it shows) and on a build where the file has not arrived yet
 * there is nothing inside the link at all, so without the name the link announces as nothing.
 */
export interface BeforeAfterImage {
  /** Path to the photograph. Leave it out and the framed ratio box stands in its place. */
  src?: string;
  /** What the photograph shows. Required whenever there is a src. */
  alt?: string;
  /** "Before" or "After", or whatever the business calls the two states. */
  label: string;
  /** One line saying what the reader is looking at. */
  caption: string;
  /** Optional destination, for a fuller case study. */
  href?: string;
  /** What that link is called. Without it the link is named from the label and the caption. */
  linkLabel?: string;
}

export interface Props {
  /** Section heading. Pass an empty string to keep it for assistive technology only. */
  heading?: string;
  /** One or two sentences framing the change. */
  lede?: string;
  before?: BeforeAfterImage;
  after?: BeforeAfterImage;
  /** Frame proportion. Both figures share one, so the pair reads as a matched set. */
  ratio?: "wide" | "photo" | "portrait";
  ctaLabel?: string;
  ctaHref?: string;
  /**
   * Anchor for this section, so a page can offer "jump to how it works" and a call to action can
   * point at it. Never defaulted: a defaulted anchor collides the moment a page carries two of a
   * piece. Internal aria wiring falls back to a per-render value, so the piece is correct with no
   * id at all.
   */
  id?: string;
  /**
   * Which ground this section sits on. One name and one vocabulary across the whole kit, so a
   * page can alternate grounds without having to remember which piece calls it what. Every
   * semantic token flips with the ground in foundations.css, so nothing here restates a colour.
   */
  tone?: "default" | "subtle" | "inverse";
}

const {
  heading = "The same roof, eleven days apart",
  lede = "Most of the cost of a leaking roof is not the roof. It is the ceiling, the insulation and the fortnight of waiting for someone to call back.",
  before = {
    label: "Before",
    caption: "Rusted valley irons, two failed inspections and water tracking into the back bedroom.",
    alt: "",
  },
  after = {
    label: "After",
    caption: "New valleys, re-bedded ridge capping and a report the insurer accepted without a second visit.",
    alt: "",
  },
  ratio = "photo",
  ctaLabel = "See how the job was quoted",
  ctaHref = "#",
  id,
  tone = "default",
} = Astro.props;

/* The caller's id anchors the section. Every id inside this instance is prefixed from
   it, falling back to a per-render value so two copies on one page cannot collide. */
const uid = id || `pba-${Math.random().toString(36).slice(2, 8)}`;
const titleId = `${uid}-title`;
const headingText = heading?.trim() || "Before and after";
const headingHidden = !heading?.trim();
const ratioClass = `kit-media--${ratio}`;
const pair = [before, after].filter((f) => f && f.label && f.caption);
const showCta = Boolean(ctaLabel && ctaHref);
---

<section
  id={id || undefined}
  class:list={[
    "kit-section",
    tone === "subtle" && "kit-section--subtle",
    tone === "inverse" && "kit-section--inverse",
  ]}
  aria-labelledby={titleId}
>
  <div class="kit-container">
    <div class="pba__head">
      <h2 id={titleId} class:list={["kit-h2", headingHidden && "kit-visually-hidden"]}>{headingText}</h2>
      {lede && <p class="kit-lede pba__lede">{lede}</p>}
    </div>

    {pair.length === 0 ? (
      <p class="kit-empty pba__empty">Add a before and an after image, each with one line of caption.</p>
    ) : (
      <div class="pba__pair">
        {pair.map((figure) => (
          <figure class="pba__fig">
            {figure.href ? (
              <a
                class="pba__link"
                href={figure.href}
                aria-label={figure.linkLabel ?? `${figure.label}: ${figure.caption}`}
              >
                <span class:list={["kit-media", ratioClass]}>
                  {figure.src && (
                    <img src={figure.src} alt={figure.alt ?? ""} loading="lazy" decoding="async" />
                  )}
                </span>
              </a>
            ) : (
              <span class:list={["kit-media", ratioClass]}>
                {figure.src && (
                  <img src={figure.src} alt={figure.alt ?? ""} loading="lazy" decoding="async" />
                )}
              </span>
            )}
            <figcaption class="pba__cap">
              <span class="kit-label pba__tag">{figure.label}</span>
              <span class="pba__text">{figure.caption}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    )}

    {showCta && (
      <p class="pba__cta">
        <a class="kit-btn kit-btn--secondary" href={ctaHref}>{ctaLabel}</a>
      </p>
    )}
  </div>
</section>

<style>
  /* --kit-accent-lift is the variant meant for dark grounds, but its fallback chain ends at
     --kit-accent, which is near-black by default and therefore invisible on --kit-bg-inverse.
     That takes the accent text, the stars and every focus ring down with it. Re-resolving it
     here reads the brand's own lifted accent when there is one and falls back to the inverse
     text colour, which the same ground already guarantees. Delete this once foundations gives
     the token a fallback suited to the ground it exists for. */
  .kit-section--inverse {
  }

  /* Same token, opposite failure: --kit-media-placeholder is --kit-bg-subtle, so a media box
     waiting for its image disappears completely on a subtle section and glares on an inverse one.
     The reserved space has to stay visible on whichever ground the piece is standing on. */
  .kit-section--subtle {
  }

  .pba__head {
    display: grid;
    gap: var(--kit-space-md);
    max-width: var(--kit-measure);
  }

  .pba__lede {
    color: var(--kit-text-muted);
  }

  .kit-section--inverse .pba__lede {
    color: color-mix(in srgb, var(--kit-text-inverse) 78%, transparent);
  }

  .pba__empty,
  .pba__pair {
    margin-block-start: var(--kit-space-2xl);
  }

  .pba__pair {
    display: grid;
    gap: var(--kit-gutter);
  }

  .pba__fig {
    margin: 0;
    min-width: 0;
    border: var(--kit-border-width) solid var(--kit-border);
    border-radius: var(--kit-radius);
    padding: var(--kit-space-sm);
    transition: border-color var(--kit-duration) var(--kit-ease);
  }

  /* The frame reacts, not the photograph: scaling a photograph on hover crops it differently at
     every viewport and hides the thing the visitor came to look at. */
  .pba__fig:has(.pba__link:hover),
  .pba__fig:focus-within {
    border-color: var(--kit-border-strong);
  }

  .pba__link {
    display: block;
    border-radius: var(--kit-media-radius);
  }

  .pba__link:focus-visible {
    outline: var(--kit-focus-width) solid var(--kit-focus-ring);
    outline-offset: var(--kit-focus-offset);
  }

  .kit-section--inverse .pba__link:focus-visible {
    outline-color: var(--kit-accent-lift);
  }

  .pba__cap {
    display: grid;
    gap: var(--kit-space-2xs);
    padding: var(--kit-space-md) var(--kit-space-xs) var(--kit-space-xs);
  }

  .pba__tag {
    color: var(--kit-accent-ink);
  }

  .kit-section--inverse .pba__tag {
    color: var(--kit-accent-lift);
  }

  .pba__text {
    font-size: var(--kit-text-base);
    line-height: var(--kit-leading-body);
    max-width: var(--kit-measure);
    text-wrap: pretty;
  }

  .pba__cta {
    margin: var(--kit-space-xl) 0 0;
  }

  @media (min-width: 48rem) {
    .pba__pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pba__fig {
      transition: none;
    }
  }
</style>
