---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Palate starter" description="Replace me: DIVERGE the concept, then build.">
  <main class="mx-auto max-w-3xl px-6 py-24">
    <h1 class="font-[var(--font-display)] text-5xl leading-tight text-brand-ink">
      Your Palate build starts here.
    </h1>
    <p class="mt-6 max-w-prose text-lg text-brand-muted">
      This is the portable Astro starter. Survey the Palate MCP, DIVERGE the concept, then
      build real sections in <code>src/pages</code>, do not ship this stub. Run
      <code>palate-verify</code> before you call it done.
    </p>
  </main>
</BaseLayout>
