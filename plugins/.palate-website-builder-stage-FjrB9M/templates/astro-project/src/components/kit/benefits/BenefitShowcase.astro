---
/**
 * BenefitShowcase: one feature that carries the product, given the room to argue for itself.
 *
 * Use it when a grid of cards would sell the important thing short. It is a paragraph, a list of
 * supporting points, and one image large enough to be worth looking at, so the image wants to be
 * the real thing at a decent size rather than a stock photograph of a laptop.
 *
 * The two columns only appear at the wide breakpoint, not the middle one. A large image squeezed
 * into half of a 768px page is neither large nor legible, so on a tablet the piece stacks and the
 * image gets the full measure.
 *
 * Supporting points accept a plain string or a label with a detail, because half the time the
 * point is a phrase and half the time it needs a clause after it, and forcing one shape on both
 * produces either a stack of fragments or a stack of paragraphs.
 */
export type ShowcasePoint = string | { label: string; detail?: string };

export interface Props {
  /** The feature's name. This is the section heading. */
  title?: string;
  /** The paragraph that says what it is and why it matters. */
  body?: string;
  /** Three to five supporting points. */
  points?: ShowcasePoint[];
  image?: {
    src?: string;
    alt?: string;
    ratio?: "wide" | "photo" | "portrait";
    caption?: string;
  };
  /** Which side the image takes on a wide screen. */
  mediaSide?: "start" | "end";
  ctaLabel?: string;
  ctaHref?: string;
  /**
   * Anchor for this section, so a page can offer "jump to how it works" and a call to action can
   * point at it. Never defaulted: a defaulted anchor collides the moment a page carries two of a
   * piece. Internal aria wiring falls back to a per-render value, so the piece is correct with no
   * id at all.
   */
  id?: string;
  /**
   * Which ground this section sits on. One name and one vocabulary across the whole kit, so a
   * page can alternate grounds without having to remember which piece calls it what. Every
   * semantic token flips with the ground in foundations.css, so nothing here restates a colour.
   */
  tone?: "default" | "subtle" | "inverse";
  emptyMessage?: string;
}

const {
  title = "Every job gets a written scope before a figure is quoted",
  body = "A scope is a page that says what is included, what is not, and which materials are going in. It takes about an hour to write and it is the single reason our jobs do not grow a third larger between the quote and the invoice.",
  points = [
    { label: "Materials named by brand and grade", detail: "So a substitution is a conversation, not a surprise." },
    { label: "Exclusions listed in plain words", detail: "Asbestos, structural repair and anything behind a wall nobody has opened." },
    { label: "A figure that holds for 30 days" },
    { label: "Variations priced before they happen", detail: "Nothing appears on the final invoice that you have not already approved." },
  ],
  image = {
    ratio: "wide",
    alt: "",
    caption: "A scope from a recent bathroom job, with the exclusions section on the second page.",
  },
  mediaSide = "end",
  ctaLabel = "See a sample scope",
  ctaHref = "#",
  id,
  tone = "default",
  emptyMessage = "The detail on this feature is being written up.",
} = Astro.props;

/* The caller's id anchors the section. Every id inside this instance is prefixed from
   it, falling back to a per-render value so two copies on one page cannot collide. */
const uid = id || `bs-${Math.random().toString(36).slice(2, 8)}`;
const titleId = `${uid}-title`;
const headingText = title?.trim() || "The feature that carries the product";
const headingHidden = !title?.trim();

const supporting = (Array.isArray(points) ? points : [])
  .map((point) => (typeof point === "string" ? { label: point } : point))
  .filter((point) => point && point.label);

const hasMedia = Boolean(image);
const ratioClass = `kit-media--${image?.ratio ?? "wide"}`;
const showCta = Boolean(ctaLabel && ctaHref);
---

<section
  id={id || undefined}
  class:list={[
    "kit-section",
    tone === "subtle" && "kit-section--subtle",
    tone === "inverse" && "kit-section--inverse",
  ]}
  aria-labelledby={titleId}
>
  <div class="kit-container">
    <div class:list={["bs__grid", hasMedia && "bs__grid--with-media"]} data-media={mediaSide}>
      <div class="bs__text">
        <h2 id={titleId} class:list={["kit-h2", headingHidden && "kit-visually-hidden"]}>{headingText}</h2>
        {body && <p class="kit-lede bs__body">{body}</p>}

        {supporting.length === 0 ? (
          <p class="kit-empty bs__empty">{emptyMessage}</p>
        ) : (
          <ul class="bs__points" role="list">
            {supporting.map((point) => (
              <li class="bs__point">
                <span class="bs__point-label">{point.label}</span>
                {point.detail && <span class="bs__point-detail kit-muted">{point.detail}</span>}
              </li>
            ))}
          </ul>
        )}

        {showCta && (
          <p class="bs__cta">
            <a class="kit-btn kit-btn--primary bs__cta-link" href={ctaHref}>{ctaLabel}</a>
          </p>
        )}
      </div>

      {hasMedia && (
        <figure class="bs__media">
          <span class:list={["kit-media", ratioClass]}>
            {image.src && <img src={image.src} alt={image.alt ?? ""} loading="lazy" decoding="async" />}
          </span>
          {image.caption && <figcaption class="bs__figcaption kit-muted">{image.caption}</figcaption>}
        </figure>
      )}
    </div>
  </div>
</section>

<style>
  /* --kit-accent-lift is the variant meant for dark grounds, but its fallback chain ends at
     --kit-accent, which is near-black by default and therefore invisible on --kit-bg-inverse.
     That takes the accent text, the stars and every focus ring down with it. Re-resolving it
     here reads the brand's own lifted accent when there is one and falls back to the inverse
     text colour, which the same ground already guarantees. Delete this once foundations gives
     the token a fallback suited to the ground it exists for. */
  .kit-section--inverse {
  }

  /* Same token, opposite failure: --kit-media-placeholder is --kit-bg-subtle, so a media box
     waiting for its image disappears completely on a subtle section and glares on an inverse one.
     The reserved space has to stay visible on whichever ground the piece is standing on. */
  .kit-section--subtle {
  }

  .bs__grid {
    display: grid;
    gap: var(--kit-space-2xl);
    align-items: center;
  }

  .bs__text {
    min-width: 0;
    display: grid;
    gap: var(--kit-space-lg);
    align-content: center;
  }

  .bs__body {
    color: var(--kit-text-muted);
    text-wrap: pretty;
  }

  .kit-section--inverse .bs__body {
    color: color-mix(in srgb, var(--kit-text-inverse) 78%, transparent);
  }

  .bs__empty {
    max-width: var(--kit-measure);
  }

  .bs__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--kit-space-md);
    max-width: var(--kit-measure);
  }

  .bs__point {
    display: grid;
    gap: var(--kit-space-2xs);
    border-block-start: var(--kit-border-width) solid var(--kit-border);
    padding-block-start: var(--kit-space-md);
    min-width: 0;
  }

  .kit-section--inverse .bs__point {
    border-block-start-color: color-mix(in srgb, var(--kit-text-inverse) 25%, transparent);
  }

  .bs__point-label {
    font-size: var(--kit-text-base);
    font-weight: var(--kit-weight-strong);
    line-height: var(--kit-leading-snug);
    text-wrap: pretty;
  }

  .bs__point-detail {
    font-size: var(--kit-text-sm);
    line-height: var(--kit-leading-body);
    text-wrap: pretty;
  }

  .bs__cta {
    margin: 0;
  }

  .bs__cta-link:focus-visible {
    outline: var(--kit-focus-width) solid var(--kit-focus-ring);
    outline-offset: var(--kit-focus-offset);
  }

  .kit-section--inverse .bs__cta-link:focus-visible {
    outline-color: var(--kit-accent-lift);
  }

  .bs__media {
    margin: 0;
    min-width: 0;
  }

  .bs__figcaption {
    font-size: var(--kit-text-xs);
    line-height: var(--kit-leading-body);
    margin-block-start: var(--kit-space-sm);
    max-width: var(--kit-measure);
    text-wrap: pretty;
  }

  /* Two columns only once there is room for the image to still be large. At the middle
     breakpoint a half-width showcase image is smaller than the stacked one, which defeats the
     point of the piece, so this piece skips that step and goes straight to the wide layout. */
  @media (min-width: 64rem) {
    .bs__grid--with-media {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
      gap: var(--kit-space-3xl);
    }

    .bs__grid--with-media[data-media="start"] .bs__media {
      order: -1;
    }
  }
</style>
