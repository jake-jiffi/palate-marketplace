---
import { galleryState, thumbnailFile } from './state.mjs';
const { state, directions, error } = galleryState();
const selectedId = state?.selection?.optionId;
---
<!doctype html>
<html lang="en-AU">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex, nofollow" /><title>Design options</title></head>
  <body>
    <a class="skip" href="#options">Skip to options</a>
    <header>
      <div><p class="eyebrow">Palate · Live preview</p><h1>Design options</h1><p>Open a direction and try it. Tell your assistant its option ID to choose it or combine ideas.</p></div>
      <a class="refresh" href="/_palate/">Refresh options</a>
    </header>
    <main id="options">
      {error ? <p class="notice" role="alert">{error}</p> : directions.length === 0 ? <p class="notice">Your first direction is being prepared. Refresh to see it when it is ready.</p> : <ul class="grid">
        {directions.map(direction => {
          const available = direction.status === 'ready';
          const hasThumbnail = Boolean(thumbnailFile(direction));
          const status = direction.stale ? 'Changed since review' : available ? 'Ready to explore' : direction.status === 'failed' ? 'Needs attention' : 'In progress';
          return <li class="card" data-option={direction.id} data-status={direction.status}>
            {hasThumbnail ? <img class="thumbnail" src={`/_palate/thumbnails/${direction.id}`} alt={`${direction.label} preview`} width="720" height="450" loading="lazy" /> : <div class="thumbnail placeholder"><span>Preview image not captured yet</span></div>}
            <div class="details"><p class="status">{status}{selectedId === direction.id && ' · Selected'}</p><h2>{direction.label}</h2><p class="rationale">{direction.rationale || 'The direction is taking shape.'}</p><p class="option-id">Option {direction.id}</p>
              {direction.status === 'failed' && <p>This direction could not be finished. Your assistant can repair it; the other options remain available.</p>}
              {direction.stale && <p>The source changed. Open the current version; it needs another review before selection.</p>}
              {available && <a class="open" href={`/_palate/directions/${direction.id}`}>Open {direction.label}<span aria-hidden="true"> ↗</span></a>}
            </div>
          </li>;
        })}
      </ul>}
    </main>
    <footer>These are working development previews. Refresh this page to see progress. Your choice is saved through the conversation.</footer>
  </body>
</html>
<style>
  * { box-sizing: border-box; }
  html { font-family: ui-sans-serif, system-ui, sans-serif; color: #202321; background: #f4f5f2; }
  body { margin: 0 auto; max-width: 1560px; padding: clamp(20px, 4vw, 64px); }
  a { color: inherit; text-underline-offset: 4px; }
  :focus-visible { outline: 3px solid #285bd7; outline-offset: 5px; }
  .skip { position: absolute; top: -100px; padding: 14px; background: white; }
  .skip:focus { top: 12px; }
  header { display: flex; justify-content: space-between; gap: 24px; align-items: start; margin-bottom: 40px; }
  header p { max-width: 650px; line-height: 1.6; }
  .eyebrow, .option-id { font-size: 13px; letter-spacing: .06em; }
  h1 { font-size: clamp(32px, 5vw, 58px); line-height: 1.05; font-weight: 550; letter-spacing: -.04em; margin: 18px 0; }
  .refresh, .open { display: inline-flex; align-items: center; min-height: 44px; padding: 12px 16px; border: 1px solid #838a80; border-radius: 5px; }
  .refresh { flex-shrink: 0; margin-top: 10px; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 24px; }
  .card { min-width: 0; background: #fff; border: 1px solid #d1d6cc; border-radius: 8px; overflow: hidden; }
  .thumbnail { display: block; width: 100%; aspect-ratio: 8 / 5; object-fit: cover; height: auto; background: #e6e9e1; border-bottom: 1px solid #d1d6cc; }
  .placeholder { display: grid; place-items: center; color: #52594b; padding: 24px; text-align: center; font-size: 14px; }
  .details { padding: 24px; overflow-wrap: anywhere; }
  .status { color: #47533d; font-size: 13px; margin-top: 0; }
  h2 { font-size: 25px; line-height: 1.15; font-weight: 600; margin: 12px 0; }
  p { line-height: 1.55; }
  .rationale { min-height: 3em; }
  .open { margin-top: 8px; background: #253821; color: white; border-color: #253821; text-decoration: none; gap: 12px; }
  .open:hover { background: #385232; }
  .notice { background: white; border: 1px solid #d1d6cc; padding: 28px; }
  footer { margin-top: 40px; max-width: 780px; font-size: 14px; line-height: 1.6; color: #4e5747; }
  @media (max-width: 600px) { header { display: block; } .refresh { margin-top: 0; } }
</style>
