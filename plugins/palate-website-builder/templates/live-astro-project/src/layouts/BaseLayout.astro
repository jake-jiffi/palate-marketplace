---
import { site } from '../site';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  /** An absolute or root-relative image for link previews. */
  image?: string;
  /** schema.org data for this page. The home page defaults to an Organization; pass the real business. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description = site.description, lang = 'en-AU', image, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const structured = jsonLd ?? (Astro.url.pathname === '/'
  ? { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: new URL('/', Astro.site).href }
  : { '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: canonical.href });
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
    <slot name="head" />
  </head>
  <body><slot /></body>
</html>
<style is:global>
  :root { --colour-text: #171717; --colour-bg: #fff; }
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; color: var(--colour-text); background: var(--colour-bg); }
  img, video { max-width: 100%; height: auto; }
  button, input, select, textarea { font: inherit; }
  :focus-visible { outline: 3px solid currentColor; outline-offset: 4px; }
</style>
