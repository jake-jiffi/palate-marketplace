---
/**
 * USE CASES, ORGANISED BY TASK.
 *
 * Reach for this one when people arrive with a job to be done rather than an identity. A sole
 * trader and an operations manager at a hundred-van business both want to stop chasing unpaid
 * invoices, and neither of them will find themselves in a list of segments.
 *
 * The reader is scanning for a VERB, so every row leads with one and the task is set larger than
 * anything else in the section. The outcome sits beside it, because a task without its result is
 * a feature list with better grammar. Wide rows rather than cards: a card grid invites comparison,
 * and these are not alternatives to each other, they are things you either need or do not.
 *
 * ONE LINK PER ROW, stretched across the row so the whole thing is a target on a phone while only
 * the task name is in the tab order. Text inside a row cannot be selected by dragging, which is
 * the accepted cost of the pattern and the reason it is used here and not on anything holding a
 * quote, a price or a number worth copying.
 *
 * Content note: the defaults describe plainly fictional field-service work. Replace them.
 */

export interface Task {
  /** The job, led by a verb, in the words the visitor would use. */
  name: string;
  /** What they end up with. The result, not the feature that produces it. */
  outcome: string;
  href: string;
}

export interface Props {
  heading?: string;
  lede?: string;
  /** Three to eight tasks, most valuable first. */
  tasks?: Task[];
  emptyMessage?: string;
  tone?: "default" | "subtle" | "inverse";
  class?: string;
  /**
   * Anchor for this section, so a page can offer "jump to how it works" and a call to action can
   * point at it. Never defaulted: a defaulted anchor collides the moment a page carries two of a
   * piece. Internal aria wiring falls back to a per-render value, so the piece is correct with no
   * id at all.
   */
  id?: string;
}

const {
  heading = "What people come here to get done",
  lede = "Six jobs that already happen every week. Start with whichever one is costing you the most time.",
  tasks = [
    {
      name: "Quote a job while you are still standing in it",
      outcome: "A priced quote in the customer's inbox before you get back in the van.",
      href: "/tasks/quoting",
    },
    {
      name: "Move a booking without three phone calls",
      outcome: "One drag, and both the customer and the technician are told.",
      href: "/tasks/rescheduling",
    },
    {
      name: "Chase what has not been paid",
      outcome: "Every overdue invoice in one list, with the reminder already written.",
      href: "/tasks/collections",
    },
    {
      name: "Hand a job to a subcontractor",
      outcome: "They see the address, the scope and the photos, and nothing else about the customer.",
      href: "/tasks/subcontractors",
    },
    {
      name: "Prove the work was done",
      outcome: "Timestamped photos and a signature attached to the job, not sitting in someone's camera roll.",
      href: "/tasks/evidence",
    },
    {
      name: "Work out what next week can take",
      outcome: "Committed hours against available hours, before you say yes to another job.",
      href: "/tasks/capacity",
    },
  ],
  emptyMessage = "The task pages are being written.",
  tone = "default",
  class: className,
  id,
} = Astro.props;

/* The caller's id anchors the section. Internal aria wiring falls back to a
   per-render value, so two copies of a piece on one page cannot collide. */
const uid = id || `ut-${Math.random().toString(36).slice(2, 8)}`;
const headingId = `${uid}-heading`;
const list = tasks ?? [];
const toneClass =
  tone === "subtle" ? "kit-section--subtle" : tone === "inverse" ? "kit-section--inverse" : "";
---

<section
  id={id || undefined}
  class:list={["kit-section", toneClass, "ut", className]}
  aria-labelledby={headingId}
>
  <div class="kit-container">
    <div class="ut-intro kit-stack">
      <h2 id={headingId} class="kit-h2">{heading}</h2>
      {lede && <p class="kit-lede kit-muted">{lede}</p>}
    </div>

    {list.length === 0 ? (
      <p class="kit-empty">{emptyMessage}</p>
    ) : (
      <ul class="ut-list" role="list">
        {list.map((task) => (
          <li class="ut-row">
            <h3 class="ut-name">
              <a class="ut-link" href={task.href}>{task.name}</a>
            </h3>
            <p class="ut-outcome">{task.outcome}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .ut-intro { margin-block-end: var(--kit-space-2xl); }

  .ut-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The task and its outcome sit side by side once both bases fit, and stack when they do not, so
     the reflow is one decision made by the content rather than by a breakpoint. */
  .ut-row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--kit-space-xs) var(--kit-gutter);
    padding-block: var(--kit-space-lg);
    border-block-start: var(--kit-border-width) solid var(--kit-border);
    transition: border-color var(--kit-duration) var(--kit-ease);
  }

  .ut-row:last-child { border-block-end: var(--kit-border-width) solid var(--kit-border); }

  .ut-name {
    flex: 1 1 calc(var(--kit-measure) / 1.7);
    min-width: 0;
    margin: 0;
    font-family: var(--kit-font-display);
    font-weight: var(--kit-weight-display);
    font-size: var(--kit-text-2xl);
    line-height: var(--kit-leading-tight);
    letter-spacing: var(--kit-tracking-tight);
    text-wrap: balance;
  }

  .ut-outcome {
    flex: 1 1 calc(var(--kit-measure) / 2);
    min-width: 0;
    margin: 0;
    font-size: var(--kit-text-base);
    line-height: var(--kit-leading-body);
    color: var(--kit-text-muted);
    text-wrap: pretty;
  }

  .ut-link {
    color: var(--kit-text);
    text-decoration: none;
    transition: color var(--kit-duration) var(--kit-ease);
  }

  /* The stretched target: the row is one click, and only the task name is in the tab order. */
  .ut-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .ut-row:hover { border-color: var(--kit-border-strong); }
  .ut-row:hover .ut-link {
    color: var(--kit-accent-ink);
    text-decoration: underline;
  }

  .ut-link:focus-visible {
    outline: var(--kit-focus-width) solid var(--kit-focus-ring);
    outline-offset: var(--kit-focus-offset);
  }

  .ut-row:has(.ut-link:focus-visible) { border-color: var(--kit-border-strong); }

  .kit-section--inverse .ut-link { color: var(--kit-text-inverse); }
  .kit-section--inverse .ut-row:hover .ut-link { color: var(--kit-accent-lift); }
</style>
