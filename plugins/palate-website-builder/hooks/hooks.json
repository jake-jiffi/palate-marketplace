{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__palate__.*",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/palate-manifest.mjs\"" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/palate-manifest.mjs\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|MultiEdit|Workflow|apply_patch",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/palate-pretooluse.mjs\"" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(higgsfield *)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/palate-media-guard.mjs\"" },
          { "type": "command", "if": "Bash(higgs *)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/palate-media-guard.mjs\"" }
        ]
      },
      {
        "matcher": "mcp__.*higgsfield.*",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/palate-media-guard.mjs\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/palate-stop.mjs\"" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/palate-sessionstart.mjs\"" }
        ]
      }
    ]
  }
}
