---
// EXAMPLE direction board. Showing the conventions:
//
//   - the hero and the one inner section are COMPONENTS in src/components/sections/, each
//     wrapped in <SectionMark id="bN-..." />, so Compose lifts a file rather than re-extracting
//     markup from a page;
//   - the page itself does nothing but pass them to <BoardFrame>, which adds the system strip
//     and the notes panel and sets noindex;
//   - the entry in src/lib/variants.ts is the argument the board makes for itself, and the
//     board does not render without it.
//
// Claude generates b2..bN by varying the hero pattern, the inner section, the composition,
// the density, the motion plan and the design tokens within the brand, one rung of the
// ambition ladder each, one distinct library donor each.
// See references/explore-stage.md.
//
// Remember to add this board to src/lib/variants.ts, or nothing links to it and the gates
// treat the build as having registered nothing.
import BoardFrame from "../../layouts/BoardFrame.astro";
import B1Hero from "../../components/sections/B1Hero.astro";
import B1Services from "../../components/sections/B1Services.astro";
import { variants } from "../../lib/variants";

const variant = variants.find((v) => v.id === "b1");
---
{variant && (
  <BoardFrame variant={variant}>
    <B1Hero slot="hero" />
    <B1Services slot="section" />
  </BoardFrame>
)}
