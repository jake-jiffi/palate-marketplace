---
/**
 * NavSimple: a header with a brand, up to six destinations and at most one call to action.
 *
 * Reach for this when the destinations do not group. Most service businesses are here: a handful
 * of pages, one thing you want people to do. If the list needs headings, use NavDropdown instead;
 * a flat row of eleven links is the failure this piece is meant to avoid.
 *
 * The small-screen behaviour comes from NavMobileSheet, rendered inside this bar rather than as a
 * second header, so there is one header element and one set of destinations in the document. The
 * desktop list and the sheet change places at 48em, which is the one breakpoint both files agree
 * on; foundations.css has no breakpoint token, so it is written in both.
 *
 * The call to action is hidden on small screens because the sheet carries it. Rendering it twice
 * would give a screen reader two identical links to the same place.
 */
import NavMobileSheet from "./NavMobileSheet.astro";

export interface NavLink {
  label: string;
  href: string;
}
export interface NavCta {
  label: string;
  href: string;
}
export interface Props {
  /**
   * Text wordmark, and the image alt when logoSrc is set. NO DEFAULT ON PURPOSE: a nav that
   * defaults a name puts an invented firm in the header of every page of a real client's site
   * the moment somebody forgets to pass it. With neither a name nor a logo the brand link is
   * simply not rendered, which is wrong in an obvious way rather than in a plausible one.
   */
  siteName?: string;
  /** Optional logo file. Falls back to the site name set in type. */
  logoSrc?: string;
  /** Where the brand links to. */
  homeHref?: string;
  /** Two to six destinations. More than six is NavDropdown's job. */
  links?: NavLink[];
  /** One call to action, or null for none. */
  cta?: NavCta | null;
  /** Current path. Defaults to the page being rendered, so aria-current needs no wiring. */
  current?: string;
  /** Keep the bar in view while the page scrolls. */
  sticky?: boolean;
  /**
   * Which ground the bar sits on. One name and one vocabulary across the whole kit, so a page can
   * alternate grounds without having to remember which piece calls it what. Every semantic token
   * flips with the ground in foundations.css, and the mobile sheet inherits them, so neither this
   * piece nor the sheet restates a colour.
   */
  tone?: "default" | "subtle" | "inverse";
  /** Accessible name for the desktop nav landmark. */
  label?: string;
  /**
   * Anchor for this section, so a page can offer "jump to how it works" and a call to action can
   * point at it. Never defaulted: a defaulted anchor collides the moment a page carries two of a
   * piece. Internal aria wiring falls back to a per-render value, so the piece is correct with no
   * id at all.
   */
  id?: string;
}

const {
  siteName = "",
  logoSrc,
  homeHref = "/",
  links = [
    { label: "Work", href: "/work" },
    { label: "Services", href: "/services" },
    { label: "About", href: "/about" },
    { label: "Contact", href: "/contact" },
  ],
  cta = { label: "Request a quote", href: "/contact" },
  current = Astro.url.pathname,
  sticky = true,
  label = "Primary",
  tone = "default",
  id,
} = Astro.props;

/** Compare paths without letting a trailing slash, a query or a hash decide the answer. */
const normalise = (value: string): string => {
  const path = (value || "").split("?")[0].split("#")[0];
  return path.length > 1 ? path.replace(/\/+$/, "") : path;
};
const here = normalise(current);
const isCurrent = (href: string): boolean => here !== "" && normalise(href) === here;

const brand = Boolean(logoSrc || siteName);
const sheetId = `${id || `nav-${Math.random().toString(36).slice(2, 8)}`}-sheet`;
const sheetLabel = siteName ? `${siteName} menu` : "Site menu";
const toneClass =
  tone === "subtle" ? "kit-section--subtle" : tone === "inverse" ? "kit-section--inverse" : "";
---

<header class:list={["kit-nav", toneClass, sticky && "kit-nav--sticky"]} id={id || undefined}>
  <div class:list={["kit-container", "kit-nav__bar", !brand && "kit-nav__bar--nobrand"]}>
    {brand && (
      <a class="kit-nav__brand" href={homeHref}>
        {logoSrc
          ? <img class="kit-nav__logo" src={logoSrc} alt={siteName} width="160" height="40" />
          : <span class="kit-nav__wordmark">{siteName}</span>}
      </a>
    )}

    {links.length > 0 && (
      <nav class="kit-nav__desktop" aria-label={label}>
        <ul class="kit-nav__list">
          {links.map((link) => (
            <li>
              <a
                class="kit-nav__link"
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {cta && (
      <a class="kit-btn kit-btn--primary kit-nav__cta" href={cta.href}>{cta.label}</a>
    )}

    <NavMobileSheet links={links} cta={cta} current={current} id={sheetId} label={sheetLabel} />
  </div>
</header>

<style>
  .kit-nav {
    background: var(--kit-bg);
    color: var(--kit-text);
    border-bottom: var(--kit-border-width) solid var(--kit-border);
  }
  .kit-nav--sticky {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .kit-nav__bar {
    display: flex;
    /* Wrapping matters twice: a long wordmark plus a long link list on a narrow desktop, and the
       no-JavaScript sheet panel, which claims a full line of its own. */
    flex-wrap: wrap;
    align-items: center;
    gap: var(--kit-space-md);
    padding-block: var(--kit-space-sm);
  }
  /* With no wordmark nothing carries the auto margin that pushes the rest to the trailing edge,
     so the bar has to do it. Everything then sits right on both sizes, including the burger. */
  .kit-nav__bar--nobrand { justify-content: flex-end; }

  .kit-nav__brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--kit-target);
    color: inherit;
    text-decoration: none;
    /* The brand keeps its line and never pushes the bar wider than the viewport. */
    min-width: 0;
    /* Everything else in the bar sits to the trailing edge, including the burger, which is why
       the sheet is a direct child of the bar rather than of a right-hand cluster: as a direct
       child its no-JavaScript panel can take a full line of its own when the bar wraps. */
    margin-inline-end: auto;
  }
  .kit-nav__wordmark {
    font-family: var(--kit-font-display);
    font-weight: var(--kit-weight-display);
    font-size: var(--kit-text-lg);
    letter-spacing: var(--kit-tracking-tight);
  }
  .kit-nav__logo {
    display: block;
    width: auto;
    height: var(--kit-space-xl);
    max-width: 100%;
  }

  .kit-nav__desktop {
    display: none;
    min-width: 0;
  }
  .kit-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--kit-space-xs) var(--kit-space-lg);
  }
  .kit-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--kit-target);
    font-size: var(--kit-text-sm);
    font-weight: var(--kit-weight-medium);
    color: inherit;
    text-decoration: none;
  }
  .kit-nav__link:hover { color: var(--kit-accent-ink); }
  .kit-nav__link[aria-current="page"] {
    color: var(--kit-accent-ink);
    /* An underline as well as a colour, so the current page is not signalled by hue alone. */
    text-decoration: underline;
    text-underline-offset: var(--kit-space-2xs);
  }

  /* The sheet carries the call to action on small screens, so the bar does not repeat it. */
  .kit-nav__cta { display: none; }

  /* The wordmark is a link home and answered a pointer with nothing at all, while every
     other link in the same bar changed. Underlined rather than recoloured, because the
     bar is tone-aware and a colour shift disappears on an inverse ground. */
  .kit-nav__brand:hover { text-decoration: underline; text-underline-offset: var(--kit-underline-offset);
    text-decoration-thickness: var(--kit-underline-hover); }

  .kit-nav__brand:focus-visible,
  .kit-nav__link:focus-visible,
  .kit-nav__cta:focus-visible {
    outline: var(--kit-focus-width) solid var(--kit-focus-ring);
    outline-offset: var(--kit-focus-offset);
  }

  @media (min-width: 48em) {
    .kit-nav__desktop { display: block; }
    .kit-nav__cta { display: inline-flex; }
    .kit-nav__bar { padding-block: var(--kit-space-md); }
  }
</style>
