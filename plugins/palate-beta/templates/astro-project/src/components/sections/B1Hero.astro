---
// EXAMPLE board section: the hero of board b1.
//
// THE FILE IS THE UNIT OF WORK. Compose lifts a picked board's sections by moving these files
// into the composed page, so every board section lives in its own component here and is
// wrapped in <SectionMark id="b1-hero" />. A hero written inline in the board page can only be
// re-extracted by copying markup out of it, and a copy is where a picked direction quietly
// becomes a reinterpretation of one.
//
// Claude writes b2..bN's sections the same way, varying the hero pattern, the composition, the
// density and the motion per rung. The id prefix always matches the board id.
import SectionMark from "../SectionMark.astro";
import { loadPage } from "../../lib/load";
import { home, type HomeContent } from "../../lib/content";

const data = await loadPage<HomeContent>(
  `*[_type == "page" && slug.current == "/"][0]`,
  {},
  home,
);
const { hero } = data;
---
<section class="bg-brand-bg relative px-6 py-28">
  <SectionMark id="b1-hero" />
  <div class="mx-auto max-w-3xl">
    <h1 class="font-display text-brand-text text-4xl leading-[1.08] md:text-6xl">
      {hero.heading}
    </h1>
    <p class="text-brand-muted mt-6 max-w-xl text-lg leading-relaxed">{hero.sub}</p>
    <div class="mt-10">
      <a
        href={hero.cta.href}
        class="rounded-brand bg-brand-accent text-brand-inverse inline-flex min-h-11 items-center px-6 py-3"
      >
        {hero.cta.label}
      </a>
    </div>
  </div>
</section>
