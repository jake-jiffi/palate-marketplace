---
/**
 * SystemStrip - the design system of THIS board, shown rather than described.
 *
 * ========================= WHY IT TAKES NO PROPS ==========================
 *
 * It renders from the brand layer's CSS custom properties alone. That is the whole trick: two
 * boards that set different tokens look different in the strip with nobody drawing a swatch,
 * and a board that claims a direction it did not actually implement is caught by its own strip
 * reading identical to the board beside it. A hand-authored palette row would be a claim; this
 * is a measurement.
 *
 * TWO NAMING FAMILIES EXIST IN THE WILD. A brand package built by the full token pipeline emits
 * `--brand-bg-default` / `--brand-text-primary`; the lighter packages emit `--brand-bg` /
 * `--brand-text`. Every value below chains both before its last-resort literal, so the strip
 * renders on either and never silently falls back to black on white while the site around it
 * is in the client's colours.
 *
 * It is Explore scaffolding: it ships on `/boards/*` and nowhere else, and it goes at Compose
 * with the rest of them.
 */
const ramp = [
  { label: "Display", size: "var(--brand-text-3xl, clamp(2.5rem, 6vw, 4rem))", family: "display", weight: "400" },
  { label: "Heading 1", size: "var(--brand-text-2xl, clamp(1.875rem, 4vw, 2.5rem))", family: "display", weight: "400" },
  { label: "Heading 2", size: "var(--brand-text-xl, 1.5rem)", family: "display", weight: "400" },
  { label: "Body", size: "var(--brand-text-base, 1rem)", family: "body", weight: "400" },
  { label: "Small", size: "var(--brand-text-sm, 0.8125rem)", family: "body", weight: "400" },
];

/**
 * THE LAST CHIP SHOWS THE ACCENT AS A FILL, NOT AS TEXT, and that is not a styling
 * preference. The first version set the accent as 12px LABEL text on the dark ground, which
 * axe measured at 2.29:1 across all three viewports on every board: a strip whose job is to
 * demonstrate craft, failing AA on the page a client sees first. An accent at full strength is
 * a FILL, and the legible variant of a colour FLIPS with the ground it sits on. So the chip
 * keeps its dark ground, labels itself in the inverse ink, and shows the accent as a block.
 */
const swatches = [
  { label: "Ground", value: "var(--brand-bg, var(--brand-bg-default, #ffffff))", ink: "var(--brand-text, var(--brand-text-primary, #111111))" },
  { label: "Ink", value: "var(--brand-text, var(--brand-text-primary, #111111))", ink: "var(--brand-inverse, var(--brand-text-inverse, #ffffff))" },
  { label: "Muted", value: "var(--brand-muted, var(--brand-text-muted, #6d6b65))", ink: "var(--brand-inverse, var(--brand-text-inverse, #ffffff))" },
  { label: "Accent", value: "var(--brand-accent, var(--brand-accent-default, #2f5d50))", ink: "var(--brand-inverse, var(--brand-text-inverse, #ffffff))" },
  {
    label: "Accent on dark",
    value: "var(--brand-bg-inverse, var(--brand-text, #1c1b19))",
    ink: "var(--brand-inverse, var(--brand-text-inverse, #ffffff))",
    fill: "var(--brand-accent, var(--brand-accent-default, #2f5d50))",
  },
];

const displayFamily = "var(--brand-font-display, var(--brand-font-body, Georgia, serif))";
const bodyFamily = "var(--brand-font-body, system-ui, sans-serif)";
const ground = "var(--brand-bg, var(--brand-bg-default, #ffffff))";
const ink = "var(--brand-text, var(--brand-text-primary, #111111))";
const muted = "var(--brand-muted, var(--brand-text-muted, #6d6b65))";
const accent = "var(--brand-accent, var(--brand-accent-default, #2f5d50))";
const inverse = "var(--brand-inverse, var(--brand-text-inverse, #ffffff))";
const radius = "var(--brand-radius, 4px)";
---

<section class="ss" style={`background:${ground};color:${ink};font-family:${bodyFamily}`}>
  <div class="ss-in">
    <h2 class="ss-h" style={`font-family:${displayFamily}`}>The system this direction sets</h2>
    <p class="ss-note" style={`color:${muted}`}>
      Everything below is read from the direction's own tokens, so it is what the rest of the
      site would inherit, not a sample of it.
    </p>

    <div class="ss-grid">
      <div class="ss-col">
        <h3 class="ss-sub" style={`color:${muted}`}>Type</h3>
        <ul class="ss-ramp">
          {ramp.map((step) => (
            <li class="ss-step">
              <span
                class="ss-spec"
                style={`font-family:${step.family === "display" ? displayFamily : bodyFamily};font-size:${step.size};font-weight:${step.weight};line-height:1.1`}
              >Ag</span>
              <span class="ss-step-label" style={`color:${muted}`}>{step.label}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="ss-col">
        <h3 class="ss-sub" style={`color:${muted}`}>Colour</h3>
        <ul class="ss-chips">
          {swatches.map((sw) => (
            <li class="ss-chip" style={`background:${sw.value};color:${sw.ink}`}>
              {sw.fill && <span class="ss-chip-fill" style={`background:${sw.fill}`}></span>}
              <span>{sw.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="ss-grid ss-grid--wide">
      <div class="ss-col">
        <h3 class="ss-sub" style={`color:${muted}`}>Controls</h3>
        <div class="ss-controls">
          <span
            class="ss-btn"
            data-strip="primary"
            style={`background:${accent};color:${inverse};border-radius:${radius}`}
          >Primary action</span>
          <span
            class="ss-btn ss-btn--ghost"
            data-strip="secondary"
            style={`color:${ink};border:1px solid ${ink};border-radius:${radius}`}
          >Secondary action</span>
        </div>
      </div>

      <div class="ss-col">
        <h3 class="ss-sub" style={`color:${muted}`}>A card</h3>
        <div class="ss-card" data-strip="card" style={`border:1px solid ${muted};border-radius:${radius}`}>
          <p class="ss-card-h" style={`font-family:${displayFamily}`}>A short card heading</p>
          <p class="ss-card-b" style={`color:${muted}`}>
            Two lines of the body face at the size the site actually sets it, so the density of
            a real block is visible rather than described.
          </p>
        </div>
      </div>
    </div>

    <div class="ss-col">
      <h3 class="ss-sub" style={`color:${muted}`}>Navigation</h3>
      <div class="ss-nav" data-strip="nav" style={`border-top:1px solid ${muted};border-bottom:1px solid ${muted}`}>
        <span class="ss-mark" style={`font-family:${displayFamily}`}>Wordmark</span>
        <span class="ss-links">
          <span>Work</span><span>About</span><span>Contact</span>
        </span>
        <span class="ss-navcta" style={`background:${accent};color:${inverse};border-radius:${radius}`}>Get in touch</span>
      </div>
    </div>
  </div>
</section>

<style>
  .ss { padding: 4rem 1.5rem; }
  .ss-in { max-width: 68rem; margin: 0 auto; display: grid; gap: 2.5rem; }
  .ss-h { font-size: clamp(1.25rem, 2.5vw, 1.625rem); line-height: 1.2; margin: 0; }
  .ss-note { margin: -1.75rem 0 0; max-width: 42rem; line-height: 1.6; }
  .ss-sub {
    font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 1rem;
  }
  .ss-grid { display: grid; gap: 2.5rem; grid-template-columns: 1fr 1fr; align-items: start; }
  .ss-col { min-width: 0; }
  .ss-ramp, .ss-chips { list-style: none; margin: 0; padding: 0; }
  .ss-step { display: flex; align-items: baseline; gap: 1rem; padding: 0.35rem 0; }
  .ss-spec { display: inline-block; }
  .ss-step-label { font-size: 0.75rem; letter-spacing: 0.08em; }
  .ss-chips { display: grid; grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr)); gap: 0.5rem; }
  .ss-chip {
    display: flex; align-items: flex-end; min-height: 5.5rem; padding: 0.625rem;
    font-size: 0.75rem; line-height: 1.3; position: relative;
  }
  .ss-chip-fill {
    position: absolute; inset: 0.625rem 0.625rem 2rem; display: block;
  }
  .ss-controls { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .ss-btn { display: inline-flex; align-items: center; min-height: 44px; padding: 0.625rem 1.25rem; font-size: 0.9375rem; }
  .ss-card { padding: 1.25rem; }
  .ss-card-h { margin: 0 0 0.5rem; font-size: 1.125rem; line-height: 1.25; }
  .ss-card-b { margin: 0; font-size: 0.9375rem; line-height: 1.6; }
  .ss-nav {
    display: flex; align-items: center; gap: 1.5rem; padding: 0.875rem 0; flex-wrap: wrap;
  }
  .ss-mark { font-size: 1.125rem; }
  .ss-links { display: flex; gap: 1.25rem; font-size: 0.9375rem; margin-right: auto; }
  .ss-navcta { display: inline-flex; align-items: center; min-height: 44px; padding: 0.5rem 1rem; font-size: 0.875rem; }

  @media (max-width: 48rem) {
    .ss-grid { grid-template-columns: 1fr; }
    .ss { padding: 3rem 1.25rem; }
  }
</style>
