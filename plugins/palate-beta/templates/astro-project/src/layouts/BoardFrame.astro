---
/**
 * BoardFrame - the shape every direction board takes.
 *
 * ================== WHY A BOARD AND NOT A WHOLE PAGE ======================
 *
 * Explore used to build eight complete home pages. That bought a lot of tokens and very little
 * extra information: a client deciding between directions is deciding on the entrance, the
 * system underneath it and one real section, and everything after that is the same decision
 * being re-made with more surface area. A board is those three things plus the notes that say
 * what the direction is for, which is the whole of what a pick needs.
 *
 * The frame is deliberately thin. Everything that makes one board differ from another lives in
 * the hero and section components the page passes in, and in the tokens the strip reads; the
 * frame itself must never carry styling that would make two directions look alike.
 *
 * It sets `noindex` on BaseLayout: a preview is a real, publicly fetchable origin, and a board
 * is a working document for one client naming directions they have not chosen yet.
 */
import BaseLayout from "./BaseLayout.astro";
import SystemStrip from "../components/SystemStrip.astro";
import BoardNotes from "../components/BoardNotes.astro";
import { variants, byAmbition } from "../lib/variants";
import type { Variant } from "../lib/variants";
import { business } from "../lib/business";

interface Props {
  variant: Variant;
}
const { variant } = Astro.props;
const total = byAmbition(variants).length || undefined;
---

<BaseLayout
  title={`${variant.name} - a direction for ${business.name}`}
  description={variant.what}
  noindex={true}
>
  {/* A board may need a face the brand package does not ship: a Google Fonts link goes here,
      and boards-render carries it into the artboard as an @import. Forwarded rather than
      re-declared so a board says it in exactly the place every other page says it. */}
  <slot name="head" slot="head" />
  <slot name="hero" />
  <SystemStrip />
  <slot name="section" />
  <BoardNotes variant={variant} total={total} />
</BaseLayout>
